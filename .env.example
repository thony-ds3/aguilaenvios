# [FE] Plantilla de variables para Águila Envíos (Vite).
# Copia este archivo como .env.local y pega tus valores de Supabase:
#   cp .env.example .env.local
# VITE_SUPABASE_URL: botón "Connect" del proyecto en Supabase (Project URL)
# VITE_SUPABASE_PUBLISHABLE_KEY: Settings > API Keys > clave publishable (sb_publishable_...)
# La clave publishable es pública por diseño; la seguridad la aplica RLS.
# NUNCA pegues aquí la clave secret o service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PEGA_AQUI_TU_CLAVE_PUBLISHABLE
# Modo prueba: SOLO funciona en desarrollo (`npm run dev`). En un build de producción
# se ignora aunque esté en "true". Sirve para que el chófer vea "Simular recorrido".
VITE_MODO_PRUEBA=false

# Proveedor de mosaicos del mapa (opcional). Por defecto usa OpenStreetMap público,
# cuya política de uso no permite tráfico alto. En producción usa tu proveedor (MapTiler,
# Stadia, Thunderforest, etc.) y su atribución correspondiente.
# VITE_TILES_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=TU_CLAVE
# VITE_TILES_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
